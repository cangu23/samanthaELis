# Base de datos PostgreSQL
# Ejemplo local: postgresql://usuario:contraseña@localhost:5432/cerebrito
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/cerebrito

# Secreto para firmar los tokens JWT (pon cualquier texto largo y aleatorio)
JWT_SECRET=cambia_esto_por_algo_secreto_y_largo

# Codigo para registrarse como docente
DOCENTE_CODE=CUMBAYA2025

# Puerto del servidor API (opcional, por defecto 3001)
PORT=3001
