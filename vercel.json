{
  "version": 2,
  "framework": "vite",
  "buildCommand": "pnpm --filter artifacts/infoquest build",
  "outputDirectory": "artifacts/infoquest/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://samanthaelis.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}