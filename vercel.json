{
  "version": 2,
  "buildCommand": "pnpm --filter \"./artifacts/infoquest\" build",
  "outputDirectory": "artifacts/infoquest/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://samanthaelis.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}